#!/usr/bin/env bash
# Switch nvim + ghostty + tmux + herdr together. Usage: office-theme <light|dark|flexoki>
set -euo pipefail

mode="${1:-}"
case "$mode" in
  light|dark|flexoki) ;;
  *)
    echo "usage: office-theme <light|dark|flexoki>" >&2
    exit 1
    ;;
esac

ghostty_themes="$HOME/.config/ghostty/themes"
tmux_themes="$HOME/.tmux/themes"
nvim_theme_file="$HOME/.config/nvim/theme"

case "$mode" in
  light)
    ghostty_file="theme-dunder-mifflin.conf"
    tmux_file="dunder-mifflin.conf"
    nvim_scheme="flexoki-light"
    herdr_name="catppuccin-latte"
    herdr_bg="#DDD3BE"     # dm_bg_2, tmux/.tmux/themes/dunder-mifflin.conf
    herdr_accent="#17459D" # dm_blue, same file
    herdr_yellow="#86680C" # dm_yellow, same file
    herdr_extra=""
    ;;
  dark)
    ghostty_file="theme-dunder-mifflin-dark.conf"
    tmux_file="dunder-mifflin-dark.conf"
    nvim_scheme="flexoki-dark"
    herdr_name="catppuccin"
    herdr_bg="#16233A"     # dm_bg_2, tmux/.tmux/themes/dunder-mifflin-dark.conf
    herdr_accent="#4B8BBE" # dm_blue, same file
    herdr_yellow="#F6EB61" # dm_yellow, same file
    herdr_extra=""
    ;;
  flexoki)
    ghostty_file="theme-flexoki.conf"
    tmux_file=""
    nvim_scheme="flexoki-dark"
    herdr_name="catppuccin"
    herdr_bg="#100F0F"     # flexoki_bg, tmux.conf inline Flexoki vars
    herdr_accent="#4385BE" # flexoki_blue, same
    herdr_yellow="#D0A215" # flexoki_yellow, same
    herdr_extra=$'green = "#879A39"\nred = "#AF3029"'
    ;;
esac

echo "# Active theme pointer — set by \`office-theme\` (light|dark|flexoki)." > "$ghostty_themes/theme-current.conf"
echo "config-file = $ghostty_file" >> "$ghostty_themes/theme-current.conf"

{
  echo "# Active theme pointer — set by \`office-theme\` (light|dark|flexoki)."
  if [ -n "$tmux_file" ]; then
    echo "source-file \"\$HOME/.tmux/themes/$tmux_file\""
  else
    echo "# flexoki mode: no override, falls back to the inline Flexoki styling in .tmux.conf"
  fi
} > "$tmux_themes/theme-current.conf"

echo -n "$nvim_scheme" > "$nvim_theme_file"

herdr_config="$HOME/.config/herdr/config.toml"
if [ -f "$herdr_config" ]; then
  herdr_tmp="$(mktemp)"
  in_custom=0
  while IFS= read -r line || [ -n "$line" ]; do
    if [ "$in_custom" = 1 ]; then
      case "$line" in
        \[*|"") in_custom=0 ;;
        *) continue ;;
      esac
    fi
    case "$line" in
      'name = "catppuccin"'|'name = "catppuccin-latte"')
        echo "name = \"$herdr_name\""
        continue
        ;;
      '[theme.custom]')
        echo "$line"
        echo "panel_bg = \"$herdr_bg\""
        echo "accent = \"$herdr_accent\""
        echo "blue = \"$herdr_accent\""
        [ -n "$herdr_extra" ] && echo "$herdr_extra"
        echo "yellow = \"$herdr_yellow\""
        in_custom=1
        continue
        ;;
    esac
    echo "$line"
  done < "$herdr_config" > "$herdr_tmp"
  cat "$herdr_tmp" > "$herdr_config"
  rm -f "$herdr_tmp"
fi

if command -v tmux >/dev/null 2>&1 && tmux info >/dev/null 2>&1; then
  tmux source-file "$HOME/.tmux.conf" >/dev/null 2>&1 || true
fi

if command -v herdr >/dev/null 2>&1 && herdr status server >/dev/null 2>&1; then
  herdr server reload-config >/dev/null 2>&1 || true
fi

echo "office-theme: $mode (ghostty/tmux/herdr apply live where a server is running; nvim applies on next launch)"
