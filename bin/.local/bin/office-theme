#!/usr/bin/env bash
# office-theme  light | dark | flexoki
#
# Switches ghostty and nvim together through the dotfiles' own switch points:
#   ghostty: repoints themes/theme-current.conf (the active-theme pointer),
#            then reloads it if it's the frontmost app (no CLI reload, so this
#            best-effort sends its cmd+shift+, shortcut)
#   nvim:    writes ~/.config/nvim/theme, read on next launch
# herdr isn't wired in: its [theme] block has no dunder-mifflin/flexoki theme.
set -euo pipefail

case "${1:-}" in
  light)   g="theme-dunder-mifflin.conf";      n="flexoki-light" ;;
  dark)    g="theme-dunder-mifflin-dark.conf"; n="flexoki-dark" ;;
  flexoki) g="theme-flexoki.conf";             n="flexoki-dark" ;;
  *) echo "usage: office-theme light|dark|flexoki" >&2; exit 1 ;;
esac

# ">" writes through the stow symlink, preserving it
{ printf '# Active theme pointer — set by `office-theme` (light|dark|flexoki).\n'
  printf 'config-file = %s\n' "$g"
} > "$HOME/.config/ghostty/themes/theme-current.conf"

printf '%s' "$n" > "$HOME/.config/nvim/theme"

grel="open a new window or press cmd+shift+,"
if osascript -e 'tell application "System Events" to name of first process whose frontmost is true' 2>/dev/null | rg -qi ghostty; then
  osascript -e 'tell application "System Events" to keystroke "," using {command down, shift down}' 2>/dev/null \
    && grel="reloaded" || grel="press cmd+shift+, (Accessibility not granted)"
fi

echo "office-theme: switched to '$1'"
echo "  ghostty -> $grel"
echo "  nvim    -> applies on next launch"
