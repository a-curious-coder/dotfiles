#!/usr/bin/env bash
# Blocks commits directly on main. See CLAUDE.md "Branching" for the workflow.
set -euo pipefail

branch="$(git symbolic-ref --short -q HEAD || true)"

if [[ "$branch" == "main" ]]; then
  echo "error: direct commits to main are not allowed." >&2
  echo "Create a branch first: git switch -c <type>/<short-description>" >&2
  exit 1
fi
