# Ghostty Configuration
# Main configuration file

# Font configuration
font-family = "SF Mono"
font-family = "FiraCode Nerd Font"
font-size = 16

# Window settings
window-padding-x = 10
window-padding-y = 10
window-decoration = true
macos-titlebar-style = hidden
macos-window-buttons = hidden
macos-non-native-fullscreen = false
macos-window-shadow = false

# Performance
window-vsync = true

# Cursor
cursor-style = block
cursor-style-blink = true

# Shell
shell-integration = detect
# Automatically fix the terminal info on every new server and forward your SSH environment
shell-integration-features = cursor,sudo,title,ssh-terminfo,ssh-env

# Theme — active palette is selected by themes/theme-current.conf
# (currently Dunder Mifflin; switch there to flexoki/dracula/nord/etc).
config-file = themes/theme-current.conf

# Clipboard
clipboard-read = allow
clipboard-write = allow
# Espanso on Linux Wayland pastes via Shift+Insert by default.
# Use the clipboard for that chord instead of the primary selection.
keybind = shift+insert=paste_from_clipboard

# Mouse
mouse-hide-while-typing = true

# Background
background-opacity = 1.0

# Terminal features
confirm-close-surface = false
quit-after-last-window-closed = true

# Option sends Alt (herdr alt+* keybinds; otherwise macOS types ç etc.)
macos-option-as-alt = true

# >>> herdr-radar font block
font-codepoint-map = U+E1A0-U+E1BA=Herdr Agent Icons Max
font-codepoint-map = U+E1C0-U+E1C5=Herdr Agent Icons Max
# <<< herdr-radar font block
