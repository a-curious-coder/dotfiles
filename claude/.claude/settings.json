{
  "effortLevel": "medium",
  "enableAllProjectMcpServers": false,
  "enabledPlugins": {
    "i-have-adhd@i-have-adhd": true,
    "lua-lsp@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "ruby-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "env": {
    "MAX_THINKING_TOKENS": "32000"
  },
  "extraKnownMarketplaces": {
    "i-have-adhd": {
      "source": {
        "repo": "ayghri/i-have-adhd",
        "source": "github"
      }
    },
    "ponytail": {
      "source": {
        "repo": "DietrichGebert/ponytail",
        "source": "github"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '/Users/callummclennan/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  },
  "model": "sonnet",
  "outputStyle": "Concise",
  "permissions": {
    "allow": [
      "mcp__pencil"
    ]
  },
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "statusLine": {
    "command": "bash \"/Users/callummclennan/.claude/statusline-command.sh\"",
    "type": "command"
  },
  "theme": "dark",
  "tui": "fullscreen"
}